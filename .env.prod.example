# ============================================================
# Sistema Paroquial - variáveis de PRODUÇÃO (modelo)
# Copie para .env.prod, preencha e proteja:  chmod 600 .env.prod
# .env.prod NUNCA vai para o git.
# Senhas: use só letras e números (ex.: openssl rand -hex 32).
# Caracteres como @ : / # quebram a DATABASE_URL.
# ============================================================

# --- Versão das imagens (tag por commit no Bloco 6) ---
IMAGE_TAG=latest

# --- Postgres (a DATABASE_URL é montada no compose) ---
POSTGRES_USER=paroquia
POSTGRES_PASSWORD=
POSTGRES_DB=paroquia

# --- API ---
JWT_SECRET=
# Saltos de proxy confiáveis (Caddy -> Next -> Nest). Valor definido e PROVADO no Bloco 5.
TRUST_PROXY_HOPS=
# Swagger em produção: desligado.
ENABLE_SWAGGER=false

# --- Storage de imagens (decisão 4): r2 | cloudinary ---
STORAGE_PROVIDER=

# Obrigatórias se STORAGE_PROVIDER=r2:
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Obrigatórias se STORAGE_PROVIDER=cloudinary:
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Admin (BUILD): host público das imagens, separado por vírgula ---
# Cloudinary: res.cloudinary.com
# R2: o host do R2_PUBLIC_URL, sem https:// (ex.: pub-xxxx.r2.dev ou img.seudominio.com.br)
IMAGE_HOSTS=res.cloudinary.com

# --- seed:prod (usar SÓ na primeira execução; APAGAR daqui depois) ---
ADMIN_NAME=Administrador
ADMIN_EMAIL=
ADMIN_PASSWORD=