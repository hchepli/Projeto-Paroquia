# ============================================================
# Sistema Paroquial - API (copie para .env e preencha)
# Nunca commitar o .env, só este arquivo de exemplo.
# A API NÃO SOBE se uma variável obrigatória faltar.
# ============================================================

# --- Ambiente ---
NODE_ENV=development          # development | production | test
PORT=3000

# Quantos proxies ficam na frente da API (0 = nenhum). Veja Bloco 1/Dia 2.
TRUST_PROXY_HOPS=0

# Swagger (/docs): sempre ligado fora de produção.
# Em produção fica desligado, a menos que seja true.
# ENABLE_SWAGGER=false

# Só local: imprime cada SQL do Prisma (para achar N+1).
# PRISMA_LOG_QUERIES=false

# --- Banco (obrigatório) ---
DATABASE_URL=

# --- Autenticação (obrigatório; mínimo 32 caracteres) ---
JWT_SECRET=

# --- Storage de imagens (obrigatório): r2 | cloudinary ---
STORAGE_PROVIDER=

# Obrigatórias se STORAGE_PROVIDER=r2:
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Obrigatórias se STORAGE_PROVIDER=cloudinary:
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Usadas SOMENTE pelo seed:prod (primeiro Admin) ---
# Descomente para rodar o seed e REMOVA do .env do servidor depois.
# ADMIN_NAME=Administrador
# ADMIN_EMAIL=
# ADMIN_PASSWORD=